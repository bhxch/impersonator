# Agent Safe Server - Node.js 代理服务环境变量配置 (模型映射版)
# 使用方法：复制此文件为 impersonator.env，修改后导入 systemd

# 服务监听端口 (设置为 80，接收 Nginx 转发及本地请求)
LISTEN_PORT=80

# =============================================================================
# 后端组 (BACKENDS)
# 格式：{ "id": { "target": "完整URL", "apiKey": "出口Key" } }
# target 支持完整URL: 协议://域名/路径前缀
# =============================================================================
BACKENDS='{
  "openai": {
    "target": "https://api.openai.com/v1",
    "apiKey": "sk-real-openai-key",
    "protocol": "openai"
  },
  "anthropic": {
    "target": "https://api.anthropic.com/v1",
    "apiKey": "sk-ant-real-anthropic-key",
    "protocol": "anthropic"
  },
  "openrouter": {
    "target": "https://openrouter.ai/api/v1",
    "apiKey": "sk-or-real-key"
  }
}'

# =============================================================================
# 端点配置组 (ENDPOINTS)
# 格式：数组，每个元素代表一个入口
#
# 关键配置项：
#   - path: 入口路径前缀，用于匹配请求
#   - stripPathPrefix: true时剥离path前缀后拼接到backend.target
#   - inboundBearer: 入口Bearer Token (客户端认证) 或入口API Key (客户端认证)
#   - protocol: 入口协议类型 (openai/anthropic，默认openai)
#   - default_backend: 默认后端ID
#   - mappings: 模型映射规则数组
#     - pattern: 正则表达式，匹配请求中的model
#     - target_backend: 转发到的后端ID
#     - target_model: 替换后的模型名称 (可选)
#
# 路径拼接示例：
#   backend.target: https://openrouter.ai/api/v1
#   endpoint.path: /v1
#   endpoint.stripPathPrefix: true
#   请求: /v1/chat/completions → 转发: https://openrouter.ai/api/v1/chat/completions
# =============================================================================
ENDPOINTS='[
  {
    "path": "/v1",
    "inboundBearer": "user-a-token",
    "default_backend": "openai",
    "stripPathPrefix": true,
    "mappings": [
      { "pattern": "^gpt-4$", "target_backend": "openai", "target_model": "gpt-4-turbo" },
      { "pattern": "^claude", "target_backend": "anthropic" }
    ]
  },
  {
    "path": "/v1",
    "inboundBearer": "user-b-token",
    "default_backend": "openrouter",
    "stripPathPrefix": true,
    "mappings": [
      { "pattern": "^gpt-4$", "target_backend": "openrouter", "target_model": "openrouter/gpt-4-turbo" }
    ]
  },
  {
    "path": "/anthropic/v1",
    "inboundBearer": "user-c-token",
    "default_backend": "openai",
    "protocol": "anthropic",
    "stripPathPrefix": true,
    "mappings": [
      { "pattern": "^claude", "target_backend": "openai", "target_model": "gpt-4o" }
    ]
  }
]'
