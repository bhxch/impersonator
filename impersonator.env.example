# Impersonator Proxy 环境变量配置示例
# 使用方法：复制此文件为 impersonator.env，修改后导入 systemd

# 服务监听配置
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8082

# =============================================================================
# 日志开关（缺省开启，设为 false 关闭对应日志）
# =============================================================================
LOG_MODEL_MAPPING=true       # 模型映射日志
LOG_PROTOCOL_CONVERT=true    # 协议转换日志
LOG_RATE_LIMIT=true          # 429/529 限流响应日志

# =============================================================================
# 后端配置 (BACKENDS)
# 格式：{ "id": { "target": "完整URL", ... } }
# target 支持完整URL: 协议://域名/路径前缀
# 可选字段：
#   apiKey        出口鉴权 Key；缺省为透传模式，客户端凭据直接转发
#   protocol      后端协议 (openai/anthropic，默认 openai)
#   maxRetryAfter Retry-After 覆写上限（秒），后端返回值超过该值时覆写
# =============================================================================
BACKENDS='{
  "openrouter": {
    "target": "https://openrouter.ai/api/v1",
    "protocol": "openai"
  },
  "newapi": {
    "target": "https://newapi.example.com",
    "protocol": "openai",
    "maxRetryAfter": 1
  },
  "fixed-key": {
    "target": "https://api.example.com/v1",
    "apiKey": "sk-your-backend-key",
    "protocol": "openai"
  }
}'

# =============================================================================
# 端点配置组 (ENDPOINTS)
# 格式：数组，每个元素代表一个入口
#
# 关键配置项：
#   - path: 入口路径前缀，用于匹配请求
#   - stripPathPrefix: true时剥离path前缀后拼接到backend.target
#   - inboundBearer: 入口 Bearer Token / API Key（固定鉴权；缺省为透传模式）
#   - protocol: 入口协议类型 (openai/anthropic，默认openai)
#   - responseModel: 响应中的模型名来源 (upstream=透传上游返回名，默认 / requested=改写为客户端请求名)
#     直连与协议转换均生效；仅对携带模型名的请求（body.model 或 x-model-id/x-model-name 头）改写
#   - default_backend: 默认后端ID
#   - mappings: 模型映射规则数组
#     - pattern: 正则表达式，匹配请求中的model
#     - target_backend: 转发到的后端ID
#     - target_model: 替换后的模型名称 (可选)
#
# 路径拼接示例：
#   backend.target: https://openrouter.ai/api/v1
#   endpoint.path: /anthropic/v1
#   endpoint.stripPathPrefix: true
#   请求: /anthropic/v1/chat/completions → 转发: https://openrouter.ai/api/v1/chat/completions
# =============================================================================
ENDPOINTS='[
  {
    "path": "/anthropic/v1",
    "default_backend": "openrouter",
    "protocol": "anthropic",
    "stripPathPrefix": true,
    "mappings": []
  },
  {
    "path": "/glm",
    "default_backend": "newapi",
    "protocol": "anthropic",
    "stripPathPrefix": true,
    "responseModel": "requested",
    "mappings": [
      { "pattern": "opus", "target_backend": "newapi", "target_model": "glm-5.3-flash" },
      { "pattern": "sonnet", "target_backend": "newapi", "target_model": "glm-5.3-flash" },
      { "pattern": "fable", "target_backend": "newapi", "target_model": "glm-5.3-flash" },
      { "pattern": "haiku", "target_backend": "newapi", "target_model": "glm-5.3-flash" }
    ]
  },
  {
    "path": "/qwen",
    "default_backend": "newapi",
    "protocol": "anthropic",
    "stripPathPrefix": true,
    "mappings": [
      { "pattern": "opus", "target_backend": "newapi", "target_model": "qwen4-max" },
      { "pattern": "sonnet", "target_backend": "newapi", "target_model": "qwen4-max" },
      { "pattern": "fable", "target_backend": "newapi", "target_model": "qwen4-max" },
      { "pattern": "haiku", "target_backend": "newapi", "target_model": "qwen4-max" }
    ]
  },
  {
    "path": "/deepseek",
    "default_backend": "newapi",
    "protocol": "anthropic",
    "stripPathPrefix": true,
    "mappings": [
      { "pattern": "opus", "target_backend": "newapi", "target_model": "DeepSeek-V4.1-Flash-1017" },
      { "pattern": "sonnet", "target_backend": "newapi", "target_model": "DeepSeek-V4.1-Flash-1017" },
      { "pattern": "fable", "target_backend": "newapi", "target_model": "DeepSeek-V4.1-Flash-1017" },
      { "pattern": "haiku", "target_backend": "newapi", "target_model": "DeepSeek-V4.1-Flash-1017" }
    ]
  },
  {
    "path": "/dpflash",
    "default_backend": "newapi",
    "protocol": "anthropic",
    "stripPathPrefix": true,
    "mappings": [
      { "pattern": "opus", "target_backend": "newapi", "target_model": "DeepSeek-V4.1-Flash-1017" },
      { "pattern": "sonnet", "target_backend": "newapi", "target_model": "DeepSeek-V4.1-Flash-1017" },
      { "pattern": "fable", "target_backend": "newapi", "target_model": "DeepSeek-V4.1-Flash-1017" },
      { "pattern": "haiku", "target_backend": "newapi", "target_model": "DeepSeek-V4.1-Flash-1017" }
    ]
  },
  {
    "path": "/newapi/deepseek",
    "default_backend": "newapi",
    "stripPathPrefix": true,
    "mappings": [
      { "pattern": "opus", "target_backend": "newapi", "target_model": "DeepSeek-V4.1-Flash-1017" },
      { "pattern": "sonnet", "target_backend": "newapi", "target_model": "DeepSeek-V4.1-Flash-1017" },
      { "pattern": "fable", "target_backend": "newapi", "target_model": "DeepSeek-V4.1-Flash-1017" },
      { "pattern": "haiku", "target_backend": "newapi", "target_model": "DeepSeek-V4.1-Flash-1017" }
    ]
  },
  {
    "path": "/newapi/glm",
    "default_backend": "newapi",
    "stripPathPrefix": true,
    "mappings": [
      { "pattern": "opus", "target_backend": "newapi", "target_model": "glm-5.3-flash" },
      { "pattern": "sonnet", "target_backend": "newapi", "target_model": "glm-5.3-flash" },
      { "pattern": "fable", "target_backend": "newapi", "target_model": "glm-5.3-flash" },
      { "pattern": "haiku", "target_backend": "newapi", "target_model": "glm-5.3-flash" }
    ]
  }
]'
